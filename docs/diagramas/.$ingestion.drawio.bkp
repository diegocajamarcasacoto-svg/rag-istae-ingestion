<mxfile host="app.diagrams.net"><diagram id="ingesta" name="Ingestión"><mxGraphModel dx="1100" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="1080" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value='&lt;b&gt;&lt;font style="font-size:16px"&gt;Ingestión del corpus normativo&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#555555"&gt;proceso offline · se ejecuta una vez por versión del corpus&lt;/font&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="15" width="330" height="45" as="geometry"/></mxCell><mxCell id="corpus" value='&lt;b&gt;Corpus normativo&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;46 normas · 13 externas · 33 internas&lt;br&gt;PDF y DOCX&lt;/font&gt;' style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=8;fillColor=#F4F4F4;strokeColor=#8C8C8C;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="380" y="60" width="220" height="85" as="geometry"/></mxCell><mxCell id="g1" value="&lt;b&gt;Procesamiento de documentos&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#F7F9FB;strokeColor=#8C9BAE;strokeWidth=1.5;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontFamily=Helvetica;fontSize=12;fontColor=#4A6585;" vertex="1" parent="1"><mxGeometry x="250" y="180" width="480" height="430" as="geometry"/></mxCell><mxCell id="s1" value='&lt;b&gt;Inventario&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;identificación estable por norma (EXT##, INT##) · sha256&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=22;fillColor=#EEF3F8;strokeColor=#4A6585;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="290" y="222" width="400" height="55" as="geometry"/></mxCell><mxCell id="s2" value='&lt;b&gt;Extracción estructurada&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;Docling · OCR solo si el texto digital es insuficiente&lt;br&gt;texto, encabezados, tablas y páginas&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=22;fillColor=#EEF3F8;strokeColor=#4A6585;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="290" y="305" width="400" height="68" as="geometry"/></mxCell><mxCell id="s3" value='&lt;b&gt;Fragmentación jerárquica&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;HierarchicalChunker de Docling&lt;br&gt;9.623 fragmentos&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=22;fillColor=#EEF3F8;strokeColor=#4A6585;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="290" y="401" width="400" height="68" as="geometry"/></mxCell><mxCell id="s4" value='&lt;b&gt;Unidades normativas&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;fragmento → artículo, disposición o sección&lt;br&gt;2.748 unidades (índice small-to-big)&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=22;fillColor=#FFE3A8;strokeColor=#C07A12;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="290" y="497" width="400" height="68" as="geometry"/></mxCell><mxCell id="units" value='&lt;b&gt;units.jsonl&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;2.748 unidades&lt;br&gt;fragmento → artículo&lt;/font&gt;' style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=8;fillColor=#F4F4F4;strokeColor=#8C8C8C;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="790" y="490" width="170" height="80" as="geometry"/></mxCell><mxCell id="g2" value="&lt;b&gt;Indexación&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#F7F9FB;strokeColor=#8C9BAE;